// HelderLabs ERP — schema de dados inicial
// Módulos cobertos até agora: CRM (Lead -> Opportunity -> Customer) e Gestão
// de Condomínios (Building -> Unit -> Owner/Fee, Assembly -> Vote, Expense).
// Os restantes módulos (Vendas, Faturação, Financeiro, Tarefas) vão estender
// este schema mais tarde, reutilizando sempre Tenant / User como eixo
// central, conforme o princípio de "modelo de dados integrado" do projeto.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Núcleo multi-tenant
// ---------------------------------------------------------------------------

enum TenantStatus {
  PROVISIONING
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
  DELETED
}

model Tenant {
  id         String       @id @default(cuid())
  name       String
  slug       String?      @unique
  email      String?
  phone      String?
  address    String?
  city       String?
  postalCode String?
  country    String       @default("Portugal")
  status     TenantStatus @default(ACTIVE)
  deletedAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  users          User[]
  roles          Role[]
  activities     UserActivity[]
  leads          Lead[]
  opportunities  Opportunity[]
  customers      Customer[]
  companies      Company[]
  contracts      Contract[]
  communications Communication[]
  buildings      Building[]

  settings            TenantSetting[]
  applications        ApplicationInstance[]
  branding            TenantBranding?
  entitlementsVersion Int                   @default(1)

  financeAccounts       FinanceAccount[]
  costCenters           CostCenter[]
  financeCategories     FinanceCategory[]
  financeTransactions   FinanceTransaction[]
  financeRecurringRules RecurringRule[]
  financeLoans          Loan[]

  financialTransactions FinancialTransaction[]
  budgets               Budget[]
  cashFlowProjections   CashFlowProjection[]
  bankReconciliations   BankReconciliation[]
  financialReports      FinancialReport[]

  @@map("tenants")
}

enum UserRole {
  SUPER_ADMIN
  PLATFORM_ADMIN
  TENANT_OWNER
  TENANT_ADMIN
  MANAGER
  SALES
  USER
  READ_ONLY
}

// Como esta conta entrou (para decidir se pede password ou não, e para
// associar/desassociar logins sociais). EMAIL continua a ser o único
// método com password.
enum AuthProvider {
  EMAIL
  GOOGLE
  MICROSOFT
  APPLE
}

model User {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  name         String
  email        String       @unique
  passwordHash String?
  // Autenticação Email+OTP
  otpHash      String?
  otpExpiresAt DateTime?
  otpAttempts  Int          @default(0)
  authProvider AuthProvider @default(EMAIL)
  // "sub" devolvido pelo provider OAuth — junto com authProvider, identifica
  // a conta de forma única nesse provider. Fica null para contas EMAIL.
  oauthSubject String?
  role         UserRole     @default(USER)
  roleId       String?
  customRole   Role?        @relation(fields: [roleId], references: [id])
  active       Boolean      @default(true)
  deletedAt    DateTime?

  isOnline     Boolean    @default(false)
  lastSeen     DateTime?
  sessionToken String?
  avatar       String?
  status       UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities             UserActivity[]
  assignedLeads          Lead[]                  @relation("LeadAssignedUser")
  assignedOpportunities  Opportunity[]           @relation("OpportunityAssignedUser")
  assignedCustomers      Customer[]              @relation("CustomerAssignedUser")
  assignedCompanies      Company[]               @relation("CompanyAssignedUser")
  applicationAssignments ApplicationAssignment[]

  // NULL não colide com NULL em constraints únicas do Postgres, por isso
  // vários utilizadores EMAIL (oauthSubject null) coexistem sem problema —
  // esta constraint só é "ativa" para contas que de facto têm oauthSubject.
  @@unique([authProvider, oauthSubject])
  @@index([tenantId])
  @@map("users")
}

model Role {
  id          String    @id @default(cuid())
  tenantId    String? // NULL = Perfil Global da Plataforma
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  key         String // Slug único por tenant
  name        String
  description String?
  isSystem    Boolean   @default(false)
  baseRole    UserRole  @default(USER)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users       User[]
  permissions RolePermissionLink[]

  @@unique([tenantId, key])
  @@map("roles")
}

model RolePermissionLink {
  id             String   @id @default(cuid())
  roleId         String
  role           Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionName String
  createdAt      DateTime @default(now())

  @@unique([roleId, permissionName])
  @@map("role_permission_links")
}

// ---------------------------------------------------------------------------
// CRM: Entidade Central Empresa 360º & Pipeline Comercial
// ---------------------------------------------------------------------------

enum CompanyStatus {
  POTENTIAL
  LEAD
  CUSTOMER
  EX_CUSTOMER
  SUPPLIER
  PARTNER
}

model Company {
  id                  String        @id @default(cuid())
  tenantId            String
  tenant              Tenant        @relation(fields: [tenantId], references: [id])
  legalName           String?
  tradeName           String
  taxNumber           String?
  entityType          String?       @default("LDA")
  status              CompanyStatus @default(LEAD)
  country             String        @default("Portugal")
  district            String?
  city                String?
  postalCode          String?
  address             String?
  website             String?
  email               String?
  phone               String?
  sector              String?
  employeesCount      Int?
  annualRevenueCents  BigInt?
  originSource        String?
  assignedUserId      String?
  assignedUser        User?         @relation("CompanyAssignedUser", fields: [assignedUserId], references: [id])
  creditLimitCents    BigInt?
  paymentTermsDays    Int?          @default(30)
  paymentMethod       String?       @default("TRANSFER")
  ibanMasked          String?
  ibanEncrypted       String?
  vatScheme           String?       @default("NORMAL")
  tags                String[]      @default([])
  notes               String?
  internalNotes       String?
  riskScore           String?       @default("BAIXO")
  completenessPercent Int           @default(30)
  deletedAt           DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  contacts      CompanyContact[]
  addresses     CompanyAddress[]
  documents     CompanyDocument[]
  contracts     Contract[]
  fromRelations CompanyRelation[]    @relation("FromCompany")
  toRelations   CompanyRelation[]    @relation("ToCompany")
  transactions  FinanceTransaction[]
  leads         Lead[]
  customers     Customer[]

  @@index([tenantId])
  @@index([status])
  @@index([tradeName])
  @@index([taxNumber])
  @@index([deletedAt])
  @@map("crm_companies")
}

model CompanyContact {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  role         String?
  department   String?
  email        String?
  phone        String?
  mobile       String?
  isPrimary    Boolean   @default(false)
  isBilling    Boolean   @default(false)
  isTechnical  Boolean   @default(false)
  isCommercial Boolean   @default(false)
  notes        String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([companyId])
  @@map("crm_company_contacts")
}

model CompanyAddress {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purpose    String    @default("SEDE")
  address    String
  postalCode String?
  city       String?
  country    String    @default("Portugal")
  isDefault  Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([companyId])
  @@map("crm_company_addresses")
}

model CompanyDocument {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  docType    String
  fileUrl    String?
  issueDate  DateTime?
  expiryDate DateTime?
  status     String    @default("VALID")
  uploadedBy String?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([companyId])
  @@map("crm_company_documents")
}

model Contract {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id])
  contractNumber   String
  title            String
  type             String    @default("SERVICE")
  startDate        DateTime
  endDate          DateTime?
  autoRenew        Boolean   @default(false)
  valueCents       Int       @default(0)
  billingFrequency String    @default("MONTHLY")
  status           String    @default("ACTIVE")
  documentUrl      String?
  managerId        String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([tenantId])
  @@index([companyId])
  @@index([status])
  @@map("crm_contracts")
}

model CompanyRelation {
  id            String   @id @default(cuid())
  fromCompanyId String
  fromCompany   Company  @relation("FromCompany", fields: [fromCompanyId], references: [id], onDelete: Cascade)
  toCompanyId   String
  toCompany     Company  @relation("ToCompany", fields: [toCompanyId], references: [id], onDelete: Cascade)
  relationType  String
  createdAt     DateTime @default(now())

  @@index([fromCompanyId])
  @@index([toCompanyId])
  @@map("crm_company_relations")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFICATION
  CONVERTED
  LOST
}

model Lead {
  id             String     @id @default(cuid())
  tenantId       String
  tenant         Tenant     @relation(fields: [tenantId], references: [id])
  companyId      String?
  companyRel     Company?   @relation(fields: [companyId], references: [id])
  company        String
  name           String
  email          String?
  phone          String?
  mobile         String?
  role           String?
  website        String?
  source         String
  status         LeadStatus @default(NEW)
  assignedUserId String?
  assignedUser   User?      @relation("LeadAssignedUser", fields: [assignedUserId], references: [id])
  deletedAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  opportunities  Opportunity[]
  communications Communication[]

  @@index([tenantId])
  @@index([status])
  @@index([deletedAt])
  @@map("leads")
}

enum OpportunityStage {
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Opportunity {
  id             String           @id @default(cuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  title          String
  leadId         String?
  lead           Lead?            @relation(fields: [leadId], references: [id])
  customerId     String?
  customer       Customer?        @relation(fields: [customerId], references: [id])
  stage          OpportunityStage @default(QUALIFICATION)
  estimatedValue Float
  probability    Int              @default(0)
  assignedUserId String?
  assignedUser   User?            @relation("OpportunityAssignedUser", fields: [assignedUserId], references: [id])
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([tenantId])
  @@index([stage])
  @@index([deletedAt])
  @@map("opportunities")
}

model Customer {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  companyId      String?
  companyRel     Company?  @relation(fields: [companyId], references: [id])
  companyName    String
  website        String?
  assignedUserId String?
  assignedUser   User?     @relation("CustomerAssignedUser", fields: [assignedUserId], references: [id])
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  contacts       Contact[]
  opportunities  Opportunity[]
  communications Communication[]

  @@index([tenantId])
  @@index([deletedAt])
  @@map("customers")
}

model Contact {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  name       String
  email      String?
  phone      String?
  role       String?
  isPrimary  Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([customerId])
  @@map("contacts")
}

model Communication {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  leadId          String?
  lead            Lead?     @relation(fields: [leadId], references: [id])
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  type            String // email | call | meeting | whatsapp | note
  subject         String?
  content         String?
  occurredAt      DateTime  @default(now())
  createdByUserId String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([tenantId])
  @@index([leadId])
  @@index([customerId])
  @@map("communications")
}

// ---------------------------------------------------------------------------
// Gestão de Condomínios — Tenant = administradora de condomínios (cliente
// pagante); os modelos abaixo representam os condomínios que essa
// administradora gere. Desenho herdado do plano do Antigravity (16/08/2026,
// "Guia de Arranque de Trabalho — Condomínios"), adaptado às convenções já
// usadas neste schema (cuid, @@map em snake_case, @@index([tenantId])).
//
// Isolamento multi-tenant: só Building tem tenantId direto (é o "âncora" do
// condomínio ao tenant) — Unit/Owner/Fee/Assembly/Vote/Expense isolam-se
// TRANSITIVAMENTE via buildingId/unitId/assemblyId, exatamente como Contact
// já isola transitivamente via Customer neste schema. Consequência prática:
// a Prisma Client Extension (tenantScopedClient.ts) só protege Building
// automaticamente — para os restantes modelos, o service layer tem de
// confirmar primeiro que o Building/Unit pai pertence ao tenant antes de ler
// ou escrever (ver EnterpriseCondominiosService).
// ---------------------------------------------------------------------------

model Building {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  name          String
  address       String
  municipality  String
  taxNumber     String? // NIF do condomínio
  totalPermille Int      @default(1000) // soma das permilagens
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  units      Unit[]
  assemblies Assembly[]
  expenses   Expense[]

  @@index([tenantId])
  @@map("buildings")
}

model Unit {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])
  identifier String // ex: "Bloco 4, 2 Esq"
  permille   Int // permilagem da fração
  ownerId    String?
  owner      Owner?   @relation(fields: [ownerId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  fees Fee[]

  @@index([buildingId])
  @@map("units")
}

model Owner {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  units Unit[]

  @@map("owners")
}

enum FeeStatus {
  PENDING
  PAID
  OVERDUE
}

model Fee {
  id        String    @id @default(cuid())
  unitId    String
  unit      Unit      @relation(fields: [unitId], references: [id])
  period    String // "2026-09"
  amount    Float
  status    FeeStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([unitId])
  @@index([status])
  @@map("fees")
}

enum AssemblyType {
  ORDINARY
  EXTRAORDINARY
}

model Assembly {
  id         String       @id @default(cuid())
  buildingId String
  building   Building     @relation(fields: [buildingId], references: [id])
  type       AssemblyType
  date       DateTime
  minutesUrl String? // ata digitalizada
  createdAt  DateTime     @default(now())

  votes Vote[]

  @@index([buildingId])
  @@map("assemblies")
}

model Vote {
  id         String   @id @default(cuid())
  assemblyId String
  assembly   Assembly @relation(fields: [assemblyId], references: [id])
  topic      String // ex: "Oposição a Alojamento Local"
  resultText String?
  passed     Boolean?

  @@index([assemblyId])
  @@map("votes")
}

model Expense {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])
  category   String
  amount     Float
  supplier   String?
  occurredAt DateTime @default(now())

  @@index([buildingId])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Platform Core & Super Admin Additions
// ---------------------------------------------------------------------------

// Modules
model Module {
  id          String  @id @default(cuid())
  key         String  @unique // "crm", "condominios", "rentacar" — identidade técnica, imutável
  name        String // rótulo de UI, editável
  description String?
  icon        String? // nome do ícone para o launcher
  color       String? // cor do cartão
  category    String  @default("Geral")
  sortOrder   Int     @default(100)
  isActive    Boolean @default(true) // Switch global da plataforma

  instances ApplicationInstance[]

  @@map("modules")
}

// Permissions
model Permission {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  role         UserRole
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([role, permissionId])
  @@map("role_permissions")
}

// Settings
model PlatformSetting {
  id       String @id @default(cuid())
  key      String @unique
  value    String
  category String @default("General")

  @@map("platform_settings")
}

model TenantSetting {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  key      String
  value    String
  category String @default("General")

  @@unique([tenantId, key])
  @@map("tenant_settings")
}

model TenantBranding {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Identidade visual
  logoUrl      String?
  logoDarkUrl  String?
  faviconUrl   String?
  primaryColor String  @default("#0d419f")
  accentColor  String  @default("#0d419f")
  theme        String  @default("system")

  // Identidade comercial
  displayName String?
  legalName   String?
  taxNumber   String?
  addressLine String?
  postalCode  String?
  city        String?
  country     String  @default("PT")

  // Parâmetros operacionais
  locale          String @default("pt-PT")
  timezone        String @default("Atlantic/Madeira")
  currency        String @default("EUR")
  dateFormat      String @default("dd/MM/yyyy")
  vatRate         Float  @default(23)
  fiscalYearStart Int    @default(1)

  // Comunicação
  emailFromName    String?
  emailFromAddress String?
  emailFooter      String?
  supportEmail     String?
  supportPhone     String?

  showUpsell Boolean @default(true)

  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("tenant_branding")
}

model ImpersonationSession {
  id             String    @id @default(cuid())
  actorUserId    String
  actorEmail     String
  targetTenantId String
  targetUserId   String?
  reason         String
  writeEnabled   Boolean   @default(false)
  startedAt      DateTime  @default(now())
  expiresAt      DateTime
  endedAt        DateTime?
  ipAddress      String?

  @@index([actorUserId])
  @@index([targetTenantId])
  @@map("impersonation_sessions")
}

// Audit Log encadeado com hash SHA-256 e categorização transversal
model AuditLog {
  id              String   @id @default(cuid())
  seq             BigInt   @default(autoincrement())
  actorId         String?
  actorEmail      String?
  actorType       String? // USER | SUPER_ADMIN | SYSTEM
  onBehalfOfId    String?
  impersonationId String?
  tenantId        String?
  module          String? // financas | crm | condominios | platform | auth | system
  category        String?  @default("APPLICATION") // SYSTEM | APPLICATION | SECURITY | DATABASE | API | USER
  action          String // ex: "finance.transaction.created", "crm.company.updated"
  resource        String? // ex: "FinanceTransaction", "Company"
  resourceId      String?
  description     String?
  oldValue        Json?
  newValue        Json?
  diff            Json?
  requestId       String?
  sessionId       String?
  ipAddress       String?
  userAgent       String?
  result          String?  @default("SUCCESS") // SUCCESS | FAILED
  timestamp       DateTime @default(now())
  prevHash        String?
  hash            String? // SHA-256 do payload + prevHash

  @@index([tenantId, timestamp])
  @@index([actorId])
  @@index([module])
  @@index([resource, resourceId])
  @@index([category])
  @@map("audit_logs")
}

// Account Requests
model AccountRequest {
  id                String    @id @default(cuid())
  companyName       String?
  contactName       String?
  name              String?
  email             String    @unique
  phone             String?
  intendedModule    String?
  passwordHash      String?
  status            String    @default("PENDING")
  otpHash           String?
  otpExpiresAt      DateTime?
  otpAttempts       Int       @default(0)
  acceptedTermsAt   DateTime?
  acceptedPrivacyAt DateTime?
  termsVersion      String?
  privacyVersion    String?
  emailVerifiedAt   DateTime?
  approvedBy        String?
  approvedAt        DateTime?
  rejectedBy        String?
  rejectedAt        DateTime?
  rejectionReason   String?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())

  @@map("account_requests")
}

// ---------------------------------------------------------------------------
// Módulo de Finanças Pessoais / Empresariais
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Módulo Financeiro Consolidado (Cêntimos Inteiros & Previsão por Vencimento)
// ---------------------------------------------------------------------------

enum FinanceKind {
  INCOME
  EXPENSE
}

enum FinanceMovementType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionStatus {
  PLANNED
  PAID
  CANCELLED
}

enum ApprovalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model FinanceAccount {
  id                  String    @id @default(cuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  accountType         String    @default("BANK") // BANK | CASH | DIGITAL | SAVINGS | OTHER
  openingBalanceCents Int       @default(0)
  currentBalanceCents Int       @default(0)
  currency            String    @default("EUR")
  iban                String?
  description         String?
  isDefault           Boolean   @default(false)
  status              String    @default("ACTIVE")
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  outgoingTransactions FinanceTransaction[] @relation("AccountTransactions")
  incomingTransfers    FinanceTransaction[] @relation("TransferToTransactions")

  @@index([tenantId])
  @@map("finance_accounts")
}

model CostCenter {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String
  name        String
  description String?
  parentId    String?
  parent      CostCenter?  @relation("CostCenterTree", fields: [parentId], references: [id])
  children    CostCenter[] @relation("CostCenterTree")
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  transactions FinanceTransaction[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("finance_cost_centers")
}

model FinanceCategory {
  id                String            @id @default(cuid())
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  kind              FinanceKind
  color             String?
  icon              String?
  isSystem          Boolean           @default(false)
  parentId          String?
  parent            FinanceCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children          FinanceCategory[] @relation("CategoryTree")
  sortOrder         Int               @default(100)

{
    "name": "helderlabs-erp-backend",
    "version": "0.1.0",
    "private": true,
    "description": "HelderLabs ERP - backend modular (CRM, Vendas, Faturação, Financeiro, Tarefas)",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev --name init",
        "prisma:studio": "prisma studio",
        "typecheck": "tsc --noEmit",
        "test": "node scripts/collect-and-run-tests.mjs",
        "seed": "tsx prisma/seed.ts"
    },
    "dependencies": {
        "@fastify/cors": "^9.0.1",
        "@fastify/helmet": "^11.1.1",
        "@fastify/rate-limit": "^8.1.1",
        "@fastify/static": "^7.0.4",
        "@prisma/client": "^5.20.0",
        "bcrypt": "^5.1.1",
        "dotenv": "^16.4.5",
        "fastify": "^4.28.1",
        "fastify-socket.io": "^5.1.0",
        "jose": "^6.2.8",
        "jsonwebtoken": "^9.0.2",
        "socket.io": "^4.8.3",
        "zod": "^3.23.8"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "devDependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/jsonwebtoken": "^9.0.6",
        "@types/node": "^20.14.9",
        "prisma": "^5.20.0",
        "tsx": "^4.16.2",
        "typescript": "^5.5.3"
    }
}

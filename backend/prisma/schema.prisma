}

enum ApplicationStatus {
  DISABLED
  TRIAL
  ACTIVE
  GRACE
  SUSPENDED
  ARCHIVED
}

enum ApplicationAssignmentStatus {
  PENDING
  ACTIVE
  DECLINED
  REMOVED
}

model ApplicationInstance {
  id       String            @id @default(cuid())
  moduleId String
  module   Module            @relation(fields: [moduleId], references: [id])
  tenantId String

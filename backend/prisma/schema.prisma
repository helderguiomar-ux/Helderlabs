// HelderLabs ERP — schema de dados inicial
// Módulos cobertos até agora: CRM (Lead -> Opportunity -> Customer) e Gestão
// de Condomínios (Building -> Unit -> Owner/Fee, Assembly -> Vote, Expense).
// Os restantes módulos (Vendas, Faturação, Financeiro, Tarefas) vão estender
// este schema mais tarde, reutilizando sempre Tenant / User como eixo
// central, conforme o princípio de "modelo de dados integrado" do projeto.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Núcleo multi-tenant
// ---------------------------------------------------------------------------

enum TenantStatus {
  PROVISIONING
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
  DELETED
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String?      @unique
  email     String?
  phone     String?
  address   String?
  city      String?
  postalCode String?
  country   String       @default("Portugal")
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users         User[]
  activities    UserActivity[]
  leads         Lead[]
  opportunities Opportunity[]
  customers     Customer[]
  communications Communication[]
  buildings     Building[]
  
  settings      TenantSetting[]
  applications  ApplicationInstance[]
  branding      TenantBranding?
  entitlementsVersion Int @default(1)

  @@map("tenants")
}

enum UserRole {
  SUPER_ADMIN
  PLATFORM_ADMIN
  TENANT_OWNER
  TENANT_ADMIN
  MANAGER
  SALES
  USER
  READ_ONLY
}

// Como esta conta entrou (para decidir se pede password ou não, e para
// associar/desassociar logins sociais). EMAIL continua a ser o único
// método com password.
enum AuthProvider {
  EMAIL
  GOOGLE
  MICROSOFT
  APPLE
}

model User {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  name         String
  email        String       @unique
  passwordHash String?
  // Autenticação Email+OTP
  otpHash      String?
  otpExpiresAt DateTime?
  otpAttempts  Int          @default(0)
  authProvider AuthProvider @default(EMAIL)
  // "sub" devolvido pelo provider OAuth — junto com authProvider, identifica
  // a conta de forma única nesse provider. Fica null para contas EMAIL.
  oauthSubject String?
  role         UserRole     @default(USER)
  active       Boolean      @default(true)
  
  isOnline     Boolean      @default(false)
  lastSeen     DateTime?
  sessionToken String?
  avatar       String?
  status       UserStatus   @default(ACTIVE)

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  activities            UserActivity[]
  assignedLeads         Lead[]         @relation("LeadAssignedUser")
  assignedOpportunities Opportunity[]  @relation("OpportunityAssignedUser")
  assignedCustomers     Customer[]     @relation("CustomerAssignedUser")
  applicationAssignments ApplicationAssignment[]

  // NULL não colide com NULL em constraints únicas do Postgres, por isso
  // vários utilizadores EMAIL (oauthSubject null) coexistem sem problema —
  // esta constraint só é "ativa" para contas que de facto têm oauthSubject.
  @@unique([authProvider, oauthSubject])
  @@index([tenantId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// CRM: Lead -> Qualification -> Opportunity -> Proposal -> Negotiation -> Won -> Customer
// ---------------------------------------------------------------------------

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFICATION
  CONVERTED
  LOST
}

model Lead {
  id             String     @id @default(cuid())
  tenantId       String
  tenant         Tenant     @relation(fields: [tenantId], references: [id])
  company        String
  name           String
  email          String?
  phone          String?
  mobile         String?
  role           String?
  website        String?
  source         String
  status         LeadStatus @default(NEW)
  assignedUserId String?
  assignedUser   User?      @relation("LeadAssignedUser", fields: [assignedUserId], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  opportunities  Opportunity[]
  communications Communication[]

  @@index([tenantId])
  @@index([status])
  @@map("leads")
}

enum OpportunityStage {
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Opportunity {
  id             String           @id @default(cuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  title          String
  leadId         String?
  lead           Lead?            @relation(fields: [leadId], references: [id])
  customerId     String?
  customer       Customer?        @relation(fields: [customerId], references: [id])
  stage          OpportunityStage @default(QUALIFICATION)
  estimatedValue Float
  probability    Int              @default(0)
  assignedUserId String?
  assignedUser   User?            @relation("OpportunityAssignedUser", fields: [assignedUserId], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([tenantId])
  @@index([stage])
  @@map("opportunities")
}

// ---------------------------------------------------------------------------
// Cliente 360º: dados comerciais + contactos + histórico
// ---------------------------------------------------------------------------

model Customer {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  companyName    String
  website        String?
  assignedUserId String?
  assignedUser   User?    @relation("CustomerAssignedUser", fields: [assignedUserId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contacts       Contact[]
  opportunities  Opportunity[]
  communications Communication[]

  @@index([tenantId])
  @@map("customers")
}

model Contact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  name       String
  email      String?
  phone      String?
  role       String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
  @@map("contacts")
}

// Histórico de interações — partilhado entre Lead e Customer, para que o
// histórico da Lead sobreviva à conversão em Cliente (ver EnterpriseCRMService).
model Communication {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  leadId          String?
  lead            Lead?    @relation(fields: [leadId], references: [id])
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  type            String   // email | call | meeting | whatsapp | note
  subject         String?
  content         String?
  occurredAt      DateTime @default(now())
  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([tenantId])
  @@index([leadId])
  @@index([customerId])
  @@map("communications")
}

// ---------------------------------------------------------------------------
// Gestão de Condomínios — Tenant = administradora de condomínios (cliente
// pagante); os modelos abaixo representam os condomínios que essa
// administradora gere. Desenho herdado do plano do Antigravity (16/08/2026,
// "Guia de Arranque de Trabalho — Condomínios"), adaptado às convenções já
// usadas neste schema (cuid, @@map em snake_case, @@index([tenantId])).
//
// Isolamento multi-tenant: só Building tem tenantId direto (é o "âncora" do
// condomínio ao tenant) — Unit/Owner/Fee/Assembly/Vote/Expense isolam-se
// TRANSITIVAMENTE via buildingId/unitId/assemblyId, exatamente como Contact
// já isola transitivamente via Customer neste schema. Consequência prática:
// a Prisma Client Extension (tenantScopedClient.ts) só protege Building
// automaticamente — para os restantes modelos, o service layer tem de
// confirmar primeiro que o Building/Unit pai pertence ao tenant antes de ler
// ou escrever (ver EnterpriseCondominiosService).
// ---------------------------------------------------------------------------

model Building {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  name          String
  address       String
  municipality  String
  taxNumber     String?  // NIF do condomínio
  totalPermille Int      @default(1000) // soma das permilagens
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  units      Unit[]
  assemblies Assembly[]
  expenses   Expense[]

  @@index([tenantId])
  @@map("buildings")
}

model Unit {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])
  identifier String   // ex: "Bloco 4, 2 Esq"
  permille   Int      // permilagem da fração
  ownerId    String?
  owner      Owner?   @relation(fields: [ownerId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  fees Fee[]

  @@index([buildingId])
  @@map("units")
}

model Owner {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  units Unit[]

  @@map("owners")
}

enum FeeStatus {
  PENDING
  PAID
  OVERDUE
}

model Fee {
  id        String    @id @default(cuid())
  unitId    String
  unit      Unit      @relation(fields: [unitId], references: [id])
  period    String    // "2026-09"
  amount    Float
  status    FeeStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([unitId])
  @@index([status])
  @@map("fees")
}

enum AssemblyType {
  ORDINARY
  EXTRAORDINARY
}

model Assembly {
  id         String       @id @default(cuid())
  buildingId String
  building   Building     @relation(fields: [buildingId], references: [id])
  type       AssemblyType
  date       DateTime
  minutesUrl String?      // ata digitalizada
  createdAt  DateTime     @default(now())

  votes Vote[]

  @@index([buildingId])
  @@map("assemblies")
}

model Vote {
  id         String   @id @default(cuid())
  assemblyId String
  assembly   Assembly @relation(fields: [assemblyId], references: [id])
  topic      String   // ex: "Oposição a Alojamento Local"
  resultText String?
  passed     Boolean?

  @@index([assemblyId])
  @@map("votes")
}

model Expense {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])
  category   String
  amount     Float
  supplier   String?
  occurredAt DateTime @default(now())

  @@index([buildingId])
  @@map("expenses")
}
// ---------------------------------------------------------------------------
// Platform Core & Super Admin Additions
// ---------------------------------------------------------------------------

// Modules
model Module {
  id          String   @id @default(cuid())
  key         String   @unique // "crm", "condominios", "rentacar" — identidade técnica, imutável
  name        String   // rótulo de UI, editável
  description String?
  icon        String?  // nome do ícone para o launcher
  color       String?  // cor do cartão
  category    String   @default("Geral")
  sortOrder   Int      @default(100)
  isActive    Boolean  @default(true) // Switch global da plataforma
  
  instances   ApplicationInstance[]
  
  @@map("modules")
}

// Permissions
model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  
  rolePermissions RolePermission[]
  
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  role         UserRole
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  
  @@unique([role, permissionId])
  @@map("role_permissions")
}

// Settings
model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  category    String   @default("General")
  
  @@map("platform_settings")
}

model TenantSetting {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  key       String
  value     String
  category  String   @default("General")
  
  @@unique([tenantId, key])
  @@map("tenant_settings")
}

model TenantBranding {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Identidade visual
  logoUrl         String?
  logoDarkUrl     String?
  faviconUrl      String?
  primaryColor    String   @default("#0d419f")
  accentColor     String   @default("#0d419f")
  theme           String   @default("system")

  // Identidade comercial
  displayName     String?
  legalName       String?
  taxNumber       String?
  addressLine     String?
  postalCode      String?
  city            String?
  country         String   @default("PT")

  // Parâmetros operacionais
  locale          String   @default("pt-PT")
  timezone        String   @default("Atlantic/Madeira")
  currency        String   @default("EUR")
  dateFormat      String   @default("dd/MM/yyyy")
  vatRate         Float    @default(23)
  fiscalYearStart Int      @default(1)

  // Comunicação
  emailFromName   String?
  emailFromAddress String?
  emailFooter     String?
  supportEmail    String?
  supportPhone    String?

  showUpsell      Boolean  @default(true)

  updatedAt       DateTime @updatedAt
  updatedBy       String?

  @@map("tenant_branding")
}

model ImpersonationSession {
  id              String    @id @default(cuid())
  actorUserId     String
  actorEmail      String
  targetTenantId  String
  targetUserId    String?
  reason          String
  writeEnabled    Boolean   @default(false)
  startedAt       DateTime  @default(now())
  expiresAt       DateTime
  endedAt         DateTime?
  ipAddress       String?

  @@index([actorUserId])
  @@index([targetTenantId])
  @@map("impersonation_sessions")
}

// Audit Log encadeado com hash SHA-256
model AuditLog {
  id              String   @id @default(cuid())
  seq             BigInt   @default(autoincrement())
  actorId         String?
  actorEmail      String?
  actorType       String?  // USER | SUPER_ADMIN | SYSTEM
  onBehalfOfId    String?
  impersonationId String?
  tenantId        String?
  action          String   // ex: "application.status.changed"
  resource        String?
  resourceId      String?
  oldValue        Json?
  newValue        Json?
  requestId       String?
  ipAddress       String?
  userAgent       String?
  result          String?
  timestamp       DateTime @default(now())
  prevHash        String?
  hash            String?  // SHA-256 do payload + prevHash

  @@index([tenantId, timestamp])
  @@index([actorId])
  @@map("audit_logs")
}

// Account Requests
model AccountRequest {
  id           String    @id @default(cuid())
  companyName  String?
  contactName  String?
  email        String    @unique
  status       String    @default("PENDING")
  otpHash      String?
  otpExpiresAt DateTime?
  otpAttempts  Int       @default(0)
  createdAt    DateTime  @default(now())
  
  @@map("account_requests")
}

enum UserStatus {
  ACTIVE
  PENDING_APPROVAL
  SUSPENDED
  INACTIVE
}

model UserActivity {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  type          String
  description   String
  page          String?
  metadata      Json?
  
  createdAt     DateTime  @default(now())
  
  @@index([userId])
  @@index([tenantId])
  @@index([createdAt])
  @@map("user_activities")
}

enum ApplicationStatus {
  DISABLED
  TRIAL
  ACTIVE
  GRACE
  SUSPENDED
  ARCHIVED
}

enum ApplicationAssignmentStatus {
  PENDING
  ACTIVE
  DECLINED
  REMOVED
}

model ApplicationInstance {
  id              String            @id @default(cuid())
  moduleId        String
  module          Module            @relation(fields: [moduleId], references: [id])
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  status          ApplicationStatus @default(TRIAL)
  config          Json              @default("{}")

  plan            String?           // "base" | "pro" | "enterprise"
  features        String[]          @default([])
  limits          Json              @default("{}")
  validFrom       DateTime?
  validUntil      DateTime?
  graceDays       Int               @default(7)
  suspendedAt     DateTime?
  suspendedReason String?

  assignments     ApplicationAssignment[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  createdBy       String?

  @@unique([tenantId, moduleId])
  @@index([tenantId])
  @@index([status])
  @@map("application_instances")
}

model ApplicationAssignment {
  id            String                    @id @default(cuid())
  userId        String
  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String
  application   ApplicationInstance       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  roleInApp     String                    @default("USER")
  status        ApplicationAssignmentStatus @default(ACTIVE)

  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@unique([userId, applicationId])
  @@index([userId])
  @@index([applicationId])
  @@map("application_assignments")
}

  dueDate     DateTime            @db.Date
  paidDate    DateTime?           @db.Date
  status      TransactionStatus   @default(PLANNED)

  accountId         String?
  account           FinanceAccount? @relation("AccountTransactions", fields: [accountId], references: [id])
  transferToId      String?
  transferToAccount FinanceAccount? @relation("TransferToTransactions", fields: [transferToId], references: [id])

  categoryId       String?
  category         FinanceCategory? @relation(fields: [categoryId], references: [id])
  costCenterId     String?
  costCenter       CostCenter?      @relation(fields: [costCenterId], references: [id])
  companyId        String?
